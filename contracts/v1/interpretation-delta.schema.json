{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://example.invalid/email-ocel/contracts/v1/interpretation-delta.schema.json",
  "title": "InterpretationDelta",
  "required": [
    "schema_version",
    "delta_id",
    "subject_id",
    "revision",
    "operation",
    "prior_record_sha256",
    "record_ref",
    "reason_code",
    "evidence_refs",
    "observed_at",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delta_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "operation": {
      "enum": [
        "upsert",
        "supersede",
        "retract"
      ]
    },
    "prior_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "retract"
          }
        }
      },
      "then": {
        "properties": {
          "record_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "record_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "supersede",
              "retract"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "prior_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
