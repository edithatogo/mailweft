{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/email-ocel/contracts/v1/selection-request.schema.json",
  "title":"Mailweft explicit source selection request 1.0.0",
  "type":"object","additionalProperties":false,"required":["schema_version","entries"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "entries":{"type":"array","minItems":1,"maxItems":1024,"items":{
      "type":"object","additionalProperties":false,"required":["entry_id","source_path","envelope_path"],
      "properties":{
        "entry_id":{"type":"string","minLength":1,"maxLength":4096,"pattern":"\\S"},
        "source_path":{"type":"string","minLength":1},"envelope_path":{"type":"string","minLength":1}
      }
    }}
  }
}
