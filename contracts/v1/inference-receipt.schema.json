{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://example.invalid/email-ocel/contracts/v1/inference-receipt.schema.json",
  "title": "InferenceEvidenceReceipt",
  "required": [
    "schema_version",
    "receipt_id",
    "subject_id",
    "evidence_refs",
    "producer_version",
    "config_sha256",
    "method",
    "score",
    "calibration_status",
    "checks",
    "decision",
    "policy_version",
    "allowed_scope_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "enum": [
        "rule",
        "statistical",
        "local_model",
        "human_adjudication"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "calibration_status": {
      "enum": [
        "not_applicable",
        "uncalibrated",
        "heldout_calibrated",
        "out_of_domain"
      ]
    },
    "calibration_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "enum": [
              "source_anchor",
              "attribution",
              "role_domain",
              "quote_scope",
              "temporal_consistency",
              "contradiction_review",
              "authorization"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "not_applicable"
            ]
          },
          "diagnostic_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    },
    "decision": {
      "enum": [
        "candidate",
        "admit_to_enriched_view",
        "abstain",
        "quarantine",
        "reject"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "allowed_scope_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "calibration_status": {
            "const": "heldout_calibrated"
          }
        }
      },
      "then": {
        "required": [
          "calibration_record_id"
        ],
        "properties": {
          "calibration_record_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
