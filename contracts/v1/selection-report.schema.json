{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/email-ocel/contracts/v1/selection-report.schema.json",
  "title": "Mailweft selection reconciliation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "manifest_sha256",
    "log"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_sha256",
        "byte_length",
        "observed_at",
        "source_copy_id",
        "message_candidate_id",
        "observation_event_id",
        "metadata_sha256",
        "producer_sha256",
        "rights_ref_sha256",
        "scope_ref_sha256",
        "fidelity",
        "coverage_claim",
        "converter_version",
        "parser_version",
        "assurance"
      ],
      "$defs": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_copy_id": {
          "type": "string",
          "pattern": "^copy_[a-f0-9]{64}$"
        },
        "message_candidate_id": {
          "type": "string",
          "pattern": "^msg_[a-f0-9]{64}$"
        },
        "observation_event_id": {
          "type": "string",
          "pattern": "^event_[a-f0-9]{64}$"
        },
        "metadata_sha256": {
          "$ref": "#/$defs/hash"
        },
        "producer_sha256": {
          "$ref": "#/$defs/hash"
        },
        "rights_ref_sha256": {
          "$ref": "#/$defs/hash"
        },
        "scope_ref_sha256": {
          "$ref": "#/$defs/hash"
        },
        "fidelity": {
          "const": "raw_rfc5322"
        },
        "coverage_claim": {
          "enum": [
            "unknown",
            "partial",
            "complete_supplied_selection"
          ]
        },
        "converter_version": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "const": "mail-parser/1.0.1"
        },
        "assurance": {
          "const": "bytes_matched_metadata_caller_asserted"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_sha256",
        "status",
        "diagnostic",
        "receipt"
      ],
      "properties": {
        "entry_sha256": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "object"
              },
              "diagnostic": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "supplied",
        "accepted",
        "rejected",
        "unique_observations",
        "projection_status",
        "coverage_assurance",
        "ocel_sha256",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "supplied": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "unique_observations": {
          "type": "integer",
          "minimum": 0
        },
        "projection_status": {
          "enum": [
            "withheld",
            "partial",
            "complete_selection"
          ]
        },
        "coverage_assurance": {
          "const": "supplied_selection_only"
        },
        "ocel_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "log": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectTypes",
            "eventTypes",
            "objects",
            "events"
          ],
          "properties": {
            "objectTypes": {
              "type": "array"
            },
            "eventTypes": {
              "type": "array"
            },
            "objects": {
              "type": "array"
            },
            "events": {
              "type": "array"
            }
          }
        }
      ]
    }
  }
}
