 """
 from __future__ import annotations
 
+from datetime import datetime
+import re
+
+_ATTRIBUTE_TYPES = {"string", "boolean", "integer", "float", "time"}
+_RFC3339 = re.compile(r"\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})\Z")
+
+
+def _timestamp(value) -> bool:
+    if not isinstance(value, str) or not _RFC3339.fullmatch(value):
+        return False
+    try:
+        return datetime.fromisoformat(value.replace("Z", "+00:00").replace("z", "+00:00")).utcoffset() is not None
+    except ValueError:
+        return False
+
 
 def _types(items: list, description: str) -> dict:
     if not isinstance(items, list):
